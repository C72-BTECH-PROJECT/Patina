# Copy to tests/.env (git-ignored via **/.env) and fill in.
# Only needed for the tests/backend/live-*.test.mjs files, tests/backend/sweep.mjs
# and MANUAL_SMOKE.md. Usernames MUST start with t0001_ — the sweep refuses to
# touch any other account. Supabase URL / service-role key are read from
# backend/.env, never from here.
TEST_CANDIDATE_USERNAME=t0001_cand
TEST_CANDIDATE_PASSWORD=
TEST_RECRUITER_USERNAME=t0001_recr
TEST_RECRUITER_PASSWORD=

# Second owner / second candidate (T-0004..T-0007: cross-user authorization tests).
# Optional for the sweep (swept and guarded only when set); required by the
# live-shortlist-authz / live-auth-failclosed (recr2) and live-analysis-isolation
# (cand2) tests, which skip when they are missing.
TEST_RECRUITER2_USERNAME=t0001_recr2
TEST_RECRUITER2_PASSWORD=
TEST_CANDIDATE2_USERNAME=t0001_cand2
TEST_CANDIDATE2_PASSWORD=
