# Copy to tests/.env (git-ignored via **/.env) and fill in.
# Only needed for tests/backend/live-analyze.test.mjs, tests/backend/sweep.mjs
# and MANUAL_SMOKE.md. Usernames MUST start with t0001_ — the sweep refuses to
# touch any other account. Supabase URL / service-role key are read from
# backend/.env, never from here.
TEST_CANDIDATE_USERNAME=t0001_cand
TEST_CANDIDATE_PASSWORD=
TEST_RECRUITER_USERNAME=t0001_recr
TEST_RECRUITER_PASSWORD=
