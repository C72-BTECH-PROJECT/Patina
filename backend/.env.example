PORT=5001
# Required: a random value of at least 32 characters. Core refuses to start without it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
NLP_PARSE_URL=http://localhost:8000/parse
FRONTEND_URL=http://localhost:3000
# Optional (R-11). Default true: apply starts preparing the assessment question pool in the
# background. Set to false to prepare only when the candidate opens the assessment
# (status or start); the test harness sets false so live suites spend no LLM generations.
ASSESSMENT_PREPARE_ON_APPLY=
# Optional (R-11/R-12; defaults in brackets). Attempts per application [1]; automatic
# retries of a failed background preparation [2]; server time limit of a started
# attempt in minutes [15] (saves until the deadline, submissions until 30 s after it).
ASSESSMENT_MAX_ATTEMPTS=
ASSESSMENT_PREPARE_RETRIES=
ASSESSMENT_TIME_LIMIT_MINUTES=
