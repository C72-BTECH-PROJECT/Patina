# Server-side Supabase credentials. Never expose the service-role key in the frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key
SUPABASE_ANON_KEY=replace-with-your-anon-key-if-needed
FRONTEND_URL=http://localhost:3000

# github-evidence service (T-0014, ROADMAP §1.2). Unset = http://localhost:8001;
# empty = disabled (every score says GitHub evidence is not part of this deployment).
GITHUB_EVIDENCE_URL=http://localhost:8001
# Core -> service timeout in ms; longer than the service's 6 s deadline.
GITHUB_EVIDENCE_TIMEOUT_MS=8000
