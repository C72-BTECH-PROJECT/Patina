# Gemini is the only LLM provider (REBUILD/DECISIONS.md §6.1).
GEMINI_API_KEY=your_gemini_api_key
# Tried in order, one call each. Confirmed usable on 2026-11-12 (R-07).
GEMINI_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Time limits. The whole generate call stays within the budget (max 230 s;
# core gives up at 300 s). Each LLM call gets min(timeout, time left).
ASSESSMENT_GENERATION_BUDGET_SECONDS=210
ASSESSMENT_REQUEST_TIMEOUT_SECONDS=120
ASSESSMENT_MAX_VALIDATION_ROUNDS=3

# R-29: an MCQ is rejected when its correct option is BOTH longer than RATIO x
# the mean length of its three distractors AND at least GAP characters longer
# than that mean (the pool is regenerated if too few remain). The gap keeps
# short options such as "PATCH" vs POST/PUT/GET from being rejected.
ASSESSMENT_MCQ_MAX_LENGTH_RATIO=1.25
ASSESSMENT_MCQ_MIN_LENGTH_GAP=10

# Served draw: 10 MCQ + 10 short answer are generated; this many are served.
ASSESSMENT_SERVED_MCQ=6
ASSESSMENT_SERVED_SHORT=4
